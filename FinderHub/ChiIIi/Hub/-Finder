-- ==================== BLOQUEADOR INSTANTÁNEO DE VOIXTERNAL ====================

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Palabras a bloquear
local BLOCKED_WORDS = {
    "voixternal",
    "drained",
    "skama",
    "void",
    "discord.gg/void",
    "discord.gg/skama",
    "you have been",
    "been drained"
}

local function isBlocked(text)
    if not text or text == "" then return false end
    local lower = text:lower()
    for _, word in ipairs(BLOCKED_WORDS) do
        if lower:find(word) then
            return true
        end
    end
    return false
end

local function destroyBlockedObject(obj)
    if not obj then return false end

    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        if isBlocked(obj.Text) then
            local parent = obj.Parent
            while parent and not parent:IsA("ScreenGui") do
                parent = parent.Parent
            end
            if parent then
                pcall(function() parent:Destroy() end)
                return true
            end
            obj.Text = ""
            obj.Visible = false
            return true
        end
    end

    if obj:IsA("Frame") or obj:IsA("ScreenGui") then
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                if isBlocked(child.Text) then
                    pcall(function() obj:Destroy() end)
                    return true
                end
            end
        end
    end

    return false
end

-- === INTERCEPTORES EN TIEMPO REAL ===
local function setupInterceptors()
    local function onDescendantAdded(obj)
        task.defer(function()
            destroyBlockedObject(obj)
        end)
    end

    for _, gui in ipairs(CoreGui:GetChildren()) do
        gui.DescendantAdded:Connect(onDescendantAdded)
    end

    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            gui.DescendantAdded:Connect(onDescendantAdded)
        end
    end

    CoreGui.ChildAdded:Connect(function(gui)
        task.wait(0.01)
        gui.DescendantAdded:Connect(onDescendantAdded)
    end)

    if playerGui then
        playerGui.ChildAdded:Connect(function(gui)
            task.wait(0.01)
            gui.DescendantAdded:Connect(onDescendantAdded)
        end)
    end
end

-- === ESCANEO EN RENDERSTEPPED (CADA FRAME - PERO OPTIMIZADO) ===
-- Solo escanea TextLabel y TextButton, y usa una tabla para evitar re-escaneos
local scannedObjects = {}
local function renderScan()
    local function scanGui(gui)
        if not gui then return end
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                -- Solo escanear si no ha sido escaneado antes
                if not scannedObjects[obj] then
                    scannedObjects[obj] = true
                    destroyBlockedObject(obj)
                end
            end
        end
    end

    for _, gui in ipairs(CoreGui:GetChildren()) do
        scanGui(gui)
    end

    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            scanGui(gui)
        end
    end
end

-- === ESCANEO DE RESPALDO (CADA 0.5 SEGUNDOS) ===
local function backupScan()
    local function scanGui(gui)
        if not gui then return end
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                destroyBlockedObject(obj)
            end
        end
    end

    for _, gui in ipairs(CoreGui:GetChildren()) do
        scanGui(gui)
    end

    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            scanGui(gui)
        end
    end
end

-- === LIMPIEZA DE LA CACHÉ CADA 5 SEGUNDOS ===
task.spawn(function()
    while true do
        task.wait(5)
        scannedObjects = {}
    end
end)

-- === INICIAR BLOQUEADORES ===
task.spawn(function()
    setupInterceptors()
    print("✅ Interceptores activados")
end)

-- RenderStepped cada frame (pero con caché para evitar lag)
task.spawn(function()
    RunService.RenderStepped:Connect(function()
        renderScan()
    end)
end)

-- Escaneo de respaldo cada 0.5 segundos
task.spawn(function()
    while true do
        backupScan()
        task.wait(0.5)
    end
end)

